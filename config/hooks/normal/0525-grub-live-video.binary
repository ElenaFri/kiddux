#!/bin/sh

# =============================================================================
# debian-minimal-kids — mode vidéo du GRUB live (amorçage UEFI) de l'ISO.
#
# S'exécute DANS binary/ pendant l'étape binaire du build (fichiers *.binary),
# APRÈS la génération de boot/grub/config.cfg par live-build.
#
# Bug corrigé : le config.cfg de live-build (repris de l'image netinst) force
#   set gfxmode=800x600
#   set gfxpayload=keep
# GRUB affiche donc son menu en 800x600 PUIS transmet ce petit framebuffer efifb
# (non accéléré) au noyau. Le vrai pilote d'affichage (KMS) bascule ensuite vers
# la résolution native : ce changement tardif fait se superposer un instant deux
# écrans de tailles différentes, et le démarrage rame sur efifb.
#
# On aligne le live sur le système installé (etc/default/grub : GRUB_GFXMODE=auto,
# pas de keep) : « auto » prend la résolution native — identique à celle que le
# KMS précoce (etc/initramfs-tools/modules) choisit — donc plus de bascule, et
# Plymouth démarre net. Le thème du menu GRUB n'est pas affecté (il dépend de
# gfxterm, pas de gfxpayload).
# =============================================================================

set -e

CFG="boot/grub/config.cfg"
[ -e "$CFG" ] || exit 0

# 800x600 → auto (résolution native, accordée au KMS et à Plymouth).
sed -i 's/^\([[:space:]]*\)set gfxmode=800x600/\1set gfxmode=auto/' "$CFG"

# Supprime le forçage du framebuffer de GRUB vers le noyau.
sed -i '/^[[:space:]]*set gfxpayload=keep/d' "$CFG"

echo "GRUB live : gfxmode=auto, gfxpayload=keep retiré (démarrage sans clignotement)."

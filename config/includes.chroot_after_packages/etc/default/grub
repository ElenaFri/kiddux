# /etc/default/grub du SYSTÈME INSTALLÉ (copié depuis le squashfs par Calamares).
#
# Les paquets grub « -bin » (sans le méta-paquet grub-pc/grub-efi-amd64) ne
# créent pas ce fichier ; on le fournit donc nous-mêmes. À l'installation, le
# module « grubcfg » de Calamares le relit (overwrite=false) : il conserve ces
# valeurs, ajoute automatiquement « splash » (Plymouth présent) et règle
# GRUB_DISTRIBUTOR sur « Kiddux » (bootloaderEntryName du branding).
#
# Menu d'amorçage aux couleurs de Kiddux : sans GRUB_THEME, grub-mkconfig retombe
# sur le menu Debian standard (cyan sur bleu). /etc/grub.d/00_header n'applique le
# thème que si la sortie est graphique (GRUB_TERMINAL_OUTPUT=gfxterm) et que le
# fichier est lisible par GRUB (même partition que /boot). Dans le cas contraire
# il se rabat sur le menu texte : le système démarre quand même.
#
# GRUB_BACKGROUND : fond du TERMINAL graphique (distinct du thème du menu). Au
# chargement du noyau, GRUB abandonne un instant le menu gfxmenu pour le terminal ;
# sans ce réglage, /etc/grub.d/05_debian_theme y grave le fond bleu de desktop-base,
# qui clignote alors par-dessus le démarrage. On pointe donc un aplat aubergine,
# accordé au thème et à Plymouth, pour une transition sans rupture.
#
# GRUB_GFXPAYLOAD_LINUX=keep : conserve le framebuffer graphique de GRUB pour
# le noyau. Sans lui, GRUB repasse le firmware en mode TEXTE au chargement du
# noyau : console noire (rectangle noir couvrant le milieu de l'écran, juste
# après le menu). Le KMS précoce (etc/initramfs-tools/modules) prend ensuite la
# main directement sur ce framebuffer — enchaînement sans rupture.
#
# Sans effet sur le LIVE : l'ISO a son propre menu GRUB (étape binaire), et
# aucun paquet grub ici ne déclenche update-grub pendant la construction.

GRUB_DEFAULT=0
GRUB_TIMEOUT=1
GRUB_DISTRIBUTOR="Kiddux"
GRUB_CMDLINE_LINUX_DEFAULT="quiet splash"
GRUB_CMDLINE_LINUX=""

GRUB_TERMINAL_OUTPUT=gfxterm
# Liste de résolutions (la plus grande d'abord) : GRUB prend la première que le
# firmware propose, au lieu de « auto » qui retombe parfois en 800x600 (texte
# étiré sur grand écran). La dernière valeur, auto, reste un filet de sécurité.
GRUB_GFXMODE=1920x1200,1920x1080,1600x1200,1280x1024,1280x800,1024x768,auto
GRUB_GFXPAYLOAD_LINUX=keep
GRUB_THEME=/usr/share/grub/themes/kiddux/theme.txt
GRUB_BACKGROUND=/usr/share/grub/themes/kiddux/background.png

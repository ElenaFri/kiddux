#!/bin/sh
# kids-set-wallpaper — applique le fond d'écran par défaut sur chaque moniteur,
# TOUJOURS sans déformation (proportions de l'image préservées).
#
# Lancé une fois par session via l'autostart XFCE. xfdesktop 4.20 range le fond
# sous une clé xfconf qui dépend du nom du connecteur réel du moniteur
# (ex. Virtual-1 en QEMU, eDP-1 / HDMI-1 sur du matériel), que l'on ne peut pas
# figer dans un XML. On détecte donc les moniteurs connectés au démarrage.
#
# Deux garanties :
#   - l'IMAGE par défaut n'est posée que si l'utilisateur n'en a pas déjà choisi
#     une (ses changements sont conservés sur un système installé ; sur le live,
#     /etc/skel est recopié à chaque démarrage, donc le fond est toujours là) ;
#   - le STYLE « zoomed » est, lui, TOUJOURS ré-appliqué. C'est lui qui évite
#     toute déformation : l'image remplit l'écran en gardant ses proportions,
#     quitte à rogner un peu les bords selon le format de l'écran — jamais
#     d'étirement, quelle que soit la résolution. On le force aussi sur les
#     moniteurs déjà connus de xfdesktop (résolutions/écrans précédents), pour
#     qu'aucun ne reste sur le style par défaut (qui, lui, étire).

WALLPAPER="/usr/share/backgrounds/debian-minimal-kids/wallpaper.jpg"

[ -r "$WALLPAPER" ] || exit 0
command -v xfconf-query >/dev/null 2>&1 || exit 0

# Fixe une valeur xfconf (crée la propriété si besoin, met à jour sinon).
set_int() {
    xfconf-query -c xfce4-desktop -p "$1" -s "$2" 2>/dev/null \
        || xfconf-query -c xfce4-desktop -p "$1" -n -t int -s "$2" 2>/dev/null
}

# Applique image (si absente) + style sans déformation à un moniteur donné.
# $1 = clé du moniteur telle que vue par xfdesktop (ex. « monitorVirtual-1 »).
apply_monitor() {
    base="/backdrop/screen0/$1/workspace0"

    # Image par défaut : seulement si l'utilisateur n'en a pas déjà choisi une.
    if ! xfconf-query -c xfce4-desktop -p "${base}/last-image" >/dev/null 2>&1; then
        xfconf-query -c xfce4-desktop -p "${base}/last-image" -n -t string -s "$WALLPAPER" 2>/dev/null
    fi

    # image-style=5 (ZOOMED : remplit l'écran en gardant les proportions, sans
    # jamais étirer). color-style=3 (NONE) : Zoomed ne laisse aucun liseré, la
    # couleur de fond n'a donc pas d'effet visible.
    set_int "${base}/image-style" 5
    set_int "${base}/color-style" 3
}

# 1) Moniteurs actuellement connectés (noms des connecteurs RANDR).
monitors=""
if command -v xrandr >/dev/null 2>&1; then
    monitors="$(xrandr --listmonitors 2>/dev/null | awk 'NR>1 {print $NF}')"
fi
# Repli : déduire les connecteurs depuis le sysfs DRM si xrandr est absent.
if [ -z "$monitors" ]; then
    for status in /sys/class/drm/*/status; do
        [ -r "$status" ] || continue
        [ "$(cat "$status")" = "connected" ] || continue
        name="${status%/status}"   # /sys/class/drm/card0-Virtual-1
        name="${name##*/}"         # card0-Virtual-1
        name="${name#*-}"          # Virtual-1  (retire le préfixe « cardN- »)
        monitors="$monitors $name"
    done
fi
for mon in $monitors; do
    apply_monitor "monitor${mon}"
done

# 2) Moniteurs déjà connus de xfdesktop (configurés lors d'une autre résolution
#    ou sur un autre écran) : on force aussi leur style, pour qu'aucun n'étire.
existing="$(xfconf-query -c xfce4-desktop -l 2>/dev/null \
    | sed -n 's#^/backdrop/screen0/\(monitor[^/]*\)/workspace0/last-image$#\1#p' \
    | sort -u)"
for mon in $existing; do
    apply_monitor "$mon"
done

exit 0
